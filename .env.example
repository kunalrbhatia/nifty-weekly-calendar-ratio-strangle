# Server Configuration
PORT=3000
NODE_ENV=development

# Angel One SmartAPI Credentials
API_KEY=your_smartapi_api_key
CLIENT_CODE=your_client_code
CLIENT_PIN=your_client_pin
CLIENT_TOTP_PIN=your_client_totp_secret_key_for_mfa

# Telegram Notifications (optional)
USE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Slack Notifications (optional)
USE_SLACK=false
SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Strategy Parameter Overrides (optional)
EXIT_THRESHOLD_PCT=2
WORTHLESS_LTP_THRESHOLD=5
TRADE_CLOSE_HOUR=15
TRADE_CLOSE_MINUTE=20
REPORT_HOUR=15
REPORT_MINUTE=40
