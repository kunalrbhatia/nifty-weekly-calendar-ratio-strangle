{
  "name": "nifty-weekly-calendar-ratio-strangle",
  "version": "1.0.0",
  "description": "Nifty Weekly Calendar Ratio Strangle trading algorithm using Angel One SmartAPI",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint src",
    "generate-basket": "tsx src/jobs/generateBasket.ts",
    "show-pnl": "tsx src/jobs/showPnl.ts",
    "backtest": "tsx backtest/run.ts",
    "backtest:mode1": "tsx backtest/run.ts --mode 1",
    "backtest:mode2": "tsx backtest/run.ts --mode 2",
    "backtest:charts": "python3 backtest/scripts/plot.py",
    "verify": "pnpm run format:check && pnpm run lint && tsc --noEmit && pnpm run test:coverage && pnpm run build",
    "test:entry": "tsx src/jobs/runEntry.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "otplib": "^12.0.1",
    "smartapi-javascript": "^1.0.10",
    "telegraf": "^4.16.3",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0"
  }
}
